{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "*.{css,js,json,png,jpg,jpeg,gif,svg,ico,webp,woff,woff2,ttf,wasm}",
      "assets/*",
      "icons/*"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
